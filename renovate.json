{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeStrategy": "rebase",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Watch PyPI for releases of packages temporarily pinned to git",
      "managerFilePatterns": ["/^pyproject\\.toml$/"],
      "matchStrings": [
        "#\\s*renovate-gate:\\s*(?<depName>[A-Za-z0-9_.-]+)==(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "automerge": false,
      "prBodyNotes": [
        "This package is pinned to a git commit in `pyproject.toml`. Replace the git pin with `{{{depName}}}>={{{newVersion}}}` and remove the `renovate-gate` comment before merging."
      ]
    },
    {
      "description": "Group CI updates",
      "matchManagers": ["github-actions"],
      "groupName": "CI dependencies"
    },
    {
      "description": "Group Python updates",
      "matchManagers": ["poetry", "pep621", "pip_requirements", "pyenv"],
      "groupName": "Python dependencies"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
